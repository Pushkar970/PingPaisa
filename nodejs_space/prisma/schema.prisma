generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
    output = "/home/ubuntu/expense_tracker_app/nodejs_space/node_modules/.prisma/client"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  password      String?
  name          String
  googleId      String?        @unique
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  plan          UserPlan?
  subscriptions Subscription[]
  expenses      Expense[]
  incomes       Income[]
  conversations Conversation[]
  aiSuggestions AiSuggestion[]
  pushTokens    PushToken[]
}

model UserPlan {
  id                 String   @id @default(uuid())
  userId             String   @unique
  tier               String   @default("FREE")
  aiQueriesUsed      Int      @default(0)
  subscriptionCount  Int      @default(0)
  monthlyLimit       Decimal? 
  currentPeriodStart DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subscription {
  id                 String   @id @default(uuid())
  userId             String
  name               String
  category           String
  amount             Decimal
  currency           String   @default("USD")
  billingCycle       String
  nextRenewalDate    DateTime
  reminderDaysBefore Int[]    @default([])
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, nextRenewalDate])
  @@index([userId, category])
}

model Expense {
  id        String   @id @default(uuid())
  userId    String
  title     String
  amount    Decimal
  category  String
  date      DateTime
  notes     String?
  source    String   @default("manual")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, date])
  @@index([userId, category])
}

model Income {
  id        String   @id @default(uuid())
  userId    String
  title     String
  amount    Decimal
  category  String
  date      DateTime
  notes     String?
  source    String   @default("manual")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, date])
  @@index([userId, category])
}

model Conversation {
  id        String    @id @default(uuid())
  userId    String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([userId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  role           String
  content        String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([conversationId, createdAt])
}

model AiSuggestion {
  id          String   @id @default(uuid())
  userId      String
  title       String
  description String
  category    String
  icon        String
  generatedAt DateTime
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, generatedAt])
}

model PushToken {
  id         String   @id @default(uuid())
  userId     String
  token      String   @unique
  deviceType String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
